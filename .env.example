# Copy to .env (gitignored) and fill in. Only needed to deploy or to run --remote commands.
# Local dev, the stdio server and the Inspector over stdio work without it.

# From: npx wrangler d1 create expensify
D1_DATABASE_ID=

# From: npx wrangler kv namespace create OAUTH_KV
KV_NAMESPACE_ID=

# Your workers.dev subdomain: the <sub> in https://expensify-mcp.<sub>.workers.dev
WORKERS_SUBDOMAIN=

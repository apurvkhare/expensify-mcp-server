{
  "name": "expensify-mcp",
  "private": true,
  "type": "module",
  "scripts": {
    "stdio": "tsx src/stdio.ts",
    "build:ui": "vite build",
    "watch:ui": "vite build --watch",
    "typecheck:ui": "tsc -p ui/tsconfig.json",
    "dev": "npm run build:ui && node ../../scripts/with-env.mjs wrangler dev --port 8788",
    "deploy": "npm run build:ui && node ../../scripts/with-env.mjs wrangler deploy"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^0.10.3",
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/ext-apps": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "api-client": "*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "vite": "^6.4.3",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
